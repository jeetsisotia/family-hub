<?xml version="1.0" encoding="utf-8"?>
<!--
  Debug builds only. Everything stays HTTPS except 10.0.2.2, the Android emulator's address for the computer it
  runs on, where the automatic test starts a local Firestore emulator (no real data). On a phone that address
  leads nowhere.
-->
<network-security-config>
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">10.0.2.2</domain>
    </domain-config>
</network-security-config>
