rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function myMemberDoc(familyId) {
      return get(/databases/$(database)/documents/families/$(familyId)/members/$(request.auth.uid));
    }

    function familyOwnerUid(familyId) {
      return get(/databases/$(database)/documents/families/$(familyId)).data.ownerUid;
    }

    // Only approved (ACTIVE) members count as family members.
    function isFamilyMember(familyId) {
      return signedIn() &&
        exists(/databases/$(database)/documents/families/$(familyId)/members/$(request.auth.uid)) &&
        myMemberDoc(familyId).data.status == 'ACTIVE';
    }

    // Super Admin: the person who created the family.
    function isFamilyOwner(familyId) {
      return signedIn() && familyOwnerUid(familyId) == request.auth.uid;
    }

    // Super Admin, or a member the Super Admin made a Family Admin.
    function isFamilyAdmin(familyId) {
      return isFamilyOwner(familyId) ||
        (isFamilyMember(familyId) && myMemberDoc(familyId).data.get('isAdmin', false) == true);
    }

    // ---------- Section permissions (None / View / Edit per member, set by admins; unset means Edit) ----------
    // Same lists as app/.../family/Permissions.kt.
    function myPerms(familyId) { return myMemberDoc(familyId).data.get('perms', {}); }
    // Nobody restricted anywhere: whole collections may be read (keeps every existing query working).
    function unrestricted(familyId) { return isFamilyAdmin(familyId) || !('none' in myPerms(familyId).values()); }
    function canSee(familyId, section) { return isFamilyAdmin(familyId) || myPerms(familyId).get(section, 'edit') != 'none'; }
    function canEdit(familyId, section) { return isFamilyAdmin(familyId) || myPerms(familyId).get(section, 'edit') == 'edit'; }
    function finTypes() { return ['subscription', 'loan', 'account', 'card', 'debit_card', 'policy', 'goal', 'challenge', 'category', 'settle', 'budget_limit', 'merchant_rule']; }
    function calTypes() { return ['birthday']; }
    function taskTypes() { return ['reminder', 'chore', 'note', 'habit', 'meal']; }
    function docTypes() { return ['document']; }
    function healthTypes() { return ['health', 'medicine', 'vital', 'food', 'workout', 'period']; }
    function homeTypes() { return ['vault', 'maintenance', 'vehicle', 'property']; }
    function famTypes() { return ['staff', 'emergency', 'notice', 'pet', 'school']; }
    function memTypes() { return ['memory']; }
    function knownItem(t) {
      return t in finTypes() || t in calTypes() || t in taskTypes() || t in docTypes() || t in healthTypes() ||
        t in homeTypes() || t in famTypes() || t in memTypes();
    }
    // Item kinds this person may see or change, as one list, so a "type in [...]" query can be checked against it.
    function lvl(familyId, section, edit) { return edit ? canEdit(familyId, section) : canSee(familyId, section); }
    function allowedTypes(familyId, edit) {
      return (lvl(familyId, 'finance', edit) ? finTypes() : [])
        .concat(lvl(familyId, 'calendar', edit) ? calTypes() : [])
        .concat(lvl(familyId, 'tasks', edit) ? taskTypes() : [])
        .concat(lvl(familyId, 'documents', edit) ? docTypes() : [])
        .concat(lvl(familyId, 'health', edit) ? healthTypes() : [])
        .concat(lvl(familyId, 'home', edit) ? homeTypes() : [])
        .concat(lvl(familyId, 'family', edit) ? famTypes() : [])
        .concat(lvl(familyId, 'memories', edit) ? memTypes() : []);
    }
    // Kinds not in any section yet stay open to people with no "None" section (as before), never to restricted ones.
    function itemOk(familyId, t, edit) {
      return t in allowedTypes(familyId, edit) || (!knownItem(t) && unrestricted(familyId));
    }

    // Admin flag and role are unchanged by this write.
    function keepsRole() {
      return request.resource.data.get('isAdmin', false) == resource.data.get('isAdmin', false) &&
        request.resource.data.get('role', '') == resource.data.get('role', '');
    }

    match /users/{userId} {
      allow read, write: if signedIn() && request.auth.uid == userId;
    }

    // Private ("Only me") records, profile details, ID numbers and step history: owner only.
    match /users/{userId}/{document=**} {
      allow read, write: if signedIn() && request.auth.uid == userId;
    }

    // An invite code points to its family. Anyone signed in may look up a code they were given, but codes
    // cannot be listed, so families cannot be found by browsing. Admins create and update their family's code.
    match /invites/{code} {
      allow get: if signedIn();
      allow list: if false;
      allow create, update: if signedIn() &&
        request.resource.data.keys().hasOnly(['familyId', 'familyName', 'createdByUid', 'updatedAt']) &&
        request.resource.data.familyId is string &&
        getAfter(/databases/$(database)/documents/families/$(request.resource.data.familyId)).data.inviteCode == code &&
        (getAfter(/databases/$(database)/documents/families/$(request.resource.data.familyId)).data.ownerUid == request.auth.uid ||
          isFamilyAdmin(request.resource.data.familyId));
      allow delete: if signedIn() && isFamilyAdmin(resource.data.familyId);
    }

    match /families/{familyId} {
      // Members read their family; someone who asked to join may read its name while waiting.
      // Families can never be listed or searched (joining uses /invites).
      allow get: if isFamilyMember(familyId) ||
        (signedIn() && exists(/databases/$(database)/documents/families/$(familyId)/members/$(request.auth.uid)));
      allow list: if false;
      allow create: if signedIn() && request.resource.data.ownerUid == request.auth.uid;
      // Admins may change family settings; only the Super Admin may hand over or delete the family.
      allow update: if isFamilyOwner(familyId) ||
        (isFamilyAdmin(familyId) && request.resource.data.ownerUid == resource.data.ownerUid);
      allow delete: if isFamilyOwner(familyId);

      match /members/{memberUid} {
        allow read: if isFamilyMember(familyId) || (signedIn() && request.auth.uid == memberUid);
        // A person may only create their own record as PENDING_APPROVAL, unless they are creating the family.
        allow create: if signedIn() && request.auth.uid == memberUid && (
          request.resource.data.status == 'PENDING_APPROVAL' ||
          getAfter(/databases/$(database)/documents/families/$(familyId)).data.ownerUid == request.auth.uid
        );
        // The Super Admin may change anyone. A Family Admin may approve or update other members (not the
        // Super Admin) but cannot make or remove admins. Members may edit their own card, not their status,
        // role or admin flag.
        allow update: if isFamilyOwner(familyId) ||
          (isFamilyAdmin(familyId) && memberUid != familyOwnerUid(familyId) && keepsRole()) ||
          (signedIn() && request.auth.uid == memberUid && keepsRole() &&
            request.resource.data.status == resource.data.status &&
            // Nobody changes their own access.
            request.resource.data.get('perms', {}) == resource.data.get('perms', {}) &&
            request.resource.data.get('canEditFinance', true) == resource.data.get('canEditFinance', true));
        // Leaving is always allowed. A Family Admin may remove members who are not admins.
        allow delete: if isFamilyOwner(familyId) || (signedIn() && request.auth.uid == memberUid) ||
          (isFamilyAdmin(familyId) && memberUid != familyOwnerUid(familyId) && resource.data.get('isAdmin', false) == false);
      }

      // Shared records: members add, edit and move them to Recently deleted; only admins delete for good.
      match /events/{docId} {
        allow read: if isFamilyMember(familyId) && canSee(familyId, 'calendar');
        allow create, update: if isFamilyMember(familyId) && canEdit(familyId, 'calendar');
        allow delete: if isFamilyAdmin(familyId);
      }

      match /expenses/{docId} {
        allow read: if isFamilyMember(familyId) && canSee(familyId, 'finance');
        allow create, update: if isFamilyMember(familyId) && canEdit(familyId, 'finance');
        allow delete: if isFamilyAdmin(familyId);
      }

      match /tasks/{docId} {
        allow read: if isFamilyMember(familyId) && canSee(familyId, 'tasks');
        allow create, update: if isFamilyMember(familyId) && canEdit(familyId, 'tasks');
        allow delete: if isFamilyAdmin(familyId);
      }

      match /trips/{docId} {
        allow read: if isFamilyMember(familyId) && canSee(familyId, 'travel');
        allow create, update: if isFamilyMember(familyId) && canEdit(familyId, 'travel');
        allow delete: if isFamilyAdmin(familyId);
      }

      // Vault, documents, health, vehicles, loans, subscriptions, accounts, cards and more.
      match /items/{docId} {
        // Each kind of item belongs to a section (Finance, Health, Documents…); someone with no access to a
        // section loads the others by type ("type in [...]"), so their queries never touch it.
        allow read: if isFamilyMember(familyId) && (unrestricted(familyId) || resource.data.get('type', '') in allowedTypes(familyId, false));
        allow create: if isFamilyMember(familyId) && itemOk(familyId, request.resource.data.get('type', ''), true);
        allow update: if isFamilyMember(familyId) && itemOk(familyId, resource.data.get('type', ''), true) &&
          itemOk(familyId, request.resource.data.get('type', ''), true);
        allow delete: if isFamilyAdmin(familyId);
      }

      // Family chat. The "family" chat is for every approved member; a direct chat ("dm_<uidA>_<uidB>",
      // uids in sorted order) can be read only by its two people, admins included.
      match /chats/{chatId} {
        function chatDoc() {
          return get(/databases/$(database)/documents/families/$(familyId)/chats/$(chatId));
        }
        function inChat() {
          return isFamilyMember(familyId) && canSee(familyId, 'chat') &&
            (chatId == 'family' || request.auth.uid in chatDoc().data.get('memberUids', []));
        }
        function activeMember(uid) {
          return get(/databases/$(database)/documents/families/$(familyId)/members/$(uid)).data.status == 'ACTIVE';
        }

        // A direct chat that does not exist yet may be looked up only by one of its two people.
        allow get: if isFamilyMember(familyId) && (chatId == 'family' ||
          (resource == null && chatId.matches('dm_.*' + request.auth.uid + '.*')) ||
          (resource != null && request.auth.uid in resource.data.get('memberUids', [])));
        allow list: if isFamilyMember(familyId) && canSee(familyId, 'chat') && request.auth.uid in resource.data.memberUids;
        allow create: if isFamilyMember(familyId) && (
          (chatId == 'family' && request.resource.data.type == 'group' &&
            request.resource.data.keys().hasOnly(['type', 'title', 'createdByUid', 'lastAt'])) ||
          (request.resource.data.type == 'direct' &&
            request.resource.data.keys().hasOnly(['type', 'memberUids', 'createdByUid', 'lastAt']) &&
            request.resource.data.memberUids is list &&
            request.resource.data.memberUids.size() == 2 &&
            request.auth.uid in request.resource.data.memberUids &&
            request.resource.data.memberUids[0] < request.resource.data.memberUids[1] &&
            chatId == 'dm_' + request.resource.data.memberUids[0] + '_' + request.resource.data.memberUids[1] &&
            activeMember(request.resource.data.memberUids[0]) && activeMember(request.resource.data.memberUids[1]))
        );
        // Sending a message updates the last-message preview; pinning sets the pinned message.
        allow update: if inChat() &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['lastText', 'lastSenderUid', 'lastAt', 'pinnedMessageId']) &&
          request.resource.data.get('lastSenderUid', request.auth.uid) == request.auth.uid ||
          (inChat() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['pinnedMessageId']));
        allow delete: if false;

        function validAttachment(a) {
          return a is map &&
            a.keys().hasOnly(['id', 'kind', 'name', 'mime', 'size', 'parts', 'durationMs', 'wave', 'w', 'h']) &&
            a.id is string && a.id.size() > 0 && a.id.size() <= 64 &&
            a.kind in ['photo', 'voice', 'file'] &&
            a.parts is int && a.parts >= 1 && a.parts <= 8 &&
            a.size is int && a.size > 0 && a.size <= 5000000 &&
            (!('wave' in a) || (a.wave is list && a.wave.size() <= 64));
        }
        function inChatAfter() {
          return isFamilyMember(familyId) && (chatId == 'family' ||
            request.auth.uid in getAfter(/databases/$(database)/documents/families/$(familyId)/chats/$(chatId)).data.get('memberUids', []));
        }

        match /messages/{msgId} {
          function inThisChat() {
            return isFamilyMember(familyId) && (chatId == 'family' ||
              request.auth.uid in getAfter(/databases/$(database)/documents/families/$(familyId)/chats/$(chatId)).data.get('memberUids', []));
          }
          allow read: if inChat();
          allow create: if inThisChat() && canEdit(familyId, 'chat') &&
            request.resource.data.senderUid == request.auth.uid &&
            request.resource.data.text is string &&
            request.resource.data.text.size() > 0 && request.resource.data.text.size() <= 4000 &&
            request.resource.data.keys().hasOnly(['senderUid', 'senderName', 'text', 'at', 'clientAt',
              'replyToId', 'replyToText', 'replyToName', 'forwarded', 'pollOptions', 'attachment']) &&
            // A photo, voice message or file: a short description here; its bytes are in parts/ (see below).
            (!('attachment' in request.resource.data) || validAttachment(request.resource.data.attachment)) &&
            // A poll has 2 to 6 answers; the message text is its question.
            (!('pollOptions' in request.resource.data) ||
              (request.resource.data.pollOptions is list &&
                request.resource.data.pollOptions.size() >= 2 && request.resource.data.pollOptions.size() <= 6));
          // The sender may edit or delete for everyone; anyone in the chat may set only their own reaction.
          allow update: if inChat() && (
            (resource.data.senderUid == request.auth.uid &&
              request.resource.data.diff(resource.data).affectedKeys().hasOnly(['text', 'editedAt', 'deletedForAll']) &&
              request.resource.data.text is string && request.resource.data.text.size() <= 4000) ||
            (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['reactions']) &&
              request.resource.data.get('reactions', {}).diff(resource.data.get('reactions', {})).affectedKeys().hasOnly([request.auth.uid])) ||
            // Poll votes: each person sets or clears only their own vote, for one of the poll's answers.
            (resource.data.get('pollOptions', []).size() >= 2 &&
              request.resource.data.diff(resource.data).affectedKeys().hasOnly(['votes']) &&
              request.resource.data.get('votes', {}).diff(resource.data.get('votes', {})).affectedKeys().hasOnly([request.auth.uid]) &&
              (!(request.auth.uid in request.resource.data.get('votes', {})) ||
                (request.resource.data.votes[request.auth.uid] is int &&
                  request.resource.data.votes[request.auth.uid] >= 0 &&
                  request.resource.data.votes[request.auth.uid] < resource.data.pollOptions.size())))
          );
          allow delete: if false;
        }

        // Attachment bytes (Spark plan: no Cloud Storage), in parts of at most ~600 KB, readable only by the
        // people in this chat. Written once by the sender; only the sender may remove them.
        match /parts/{partId} {
          allow read: if inChat();
          allow create: if inChatAfter() &&
            request.resource.data.senderUid == request.auth.uid &&
            request.resource.data.keys().hasOnly(['senderUid', 'data', 'at']) &&
            request.resource.data.data is string && request.resource.data.data.size() > 0 &&
            request.resource.data.data.size() <= 850000;
          allow update: if false;
          allow delete: if inChat() && resource.data.senderUid == request.auth.uid;
        }

        // "Typing…": each person sets only their own, and only the time.
        match /typing/{typerUid} {
          allow read: if inChat();
          allow create, update: if inChat() && request.auth.uid == typerUid &&
            request.resource.data.keys().hasOnly(['at']);
          allow delete: if inChat() && request.auth.uid == typerUid;
        }

        // When each person last read the chat: everyone in the chat may see them, each sets only their own.
        match /reads/{readerUid} {
          allow read: if inChat();
          allow write: if inChat() && request.auth.uid == readerUid &&
            request.resource.data.keys().hasOnly(['at']);
        }
      }

      // Group calls (up to 4 people, each pair connected directly). Only invited people can see a call; each
      // person adds or removes only themselves from "joined"; the host, or anyone once nobody is left, ends it.
      // A pair's connection details can be read only by those two people.
      match /groupcalls/{callId} {
        function gcActive(uid) {
          return get(/databases/$(database)/documents/families/$(familyId)/members/$(uid)).data.status == 'ACTIVE';
        }
        function invited() { return isFamilyMember(familyId) && request.auth.uid in resource.data.memberUids; }
        allow get: if invited();
        allow list: if isFamilyMember(familyId) && request.auth.uid in resource.data.memberUids;
        allow create: if isFamilyMember(familyId) &&
          request.resource.data.keys().hasOnly(['hostUid', 'hostName', 'type', 'memberUids', 'names', 'joined', 'state', 'clientAt']) &&
          request.resource.data.hostUid == request.auth.uid &&
          request.resource.data.memberUids is list &&
          request.resource.data.memberUids.size() >= 2 && request.resource.data.memberUids.size() <= 4 &&
          request.resource.data.memberUids[0] == request.auth.uid &&
          request.resource.data.memberUids.toSet().size() == request.resource.data.memberUids.size() &&
          gcActive(request.resource.data.memberUids[1]) &&
          (request.resource.data.memberUids.size() < 3 || gcActive(request.resource.data.memberUids[2])) &&
          (request.resource.data.memberUids.size() < 4 || gcActive(request.resource.data.memberUids[3])) &&
          request.resource.data.joined == [request.auth.uid] &&
          request.resource.data.state == 'open' &&
          request.resource.data.type in ['audio', 'video'] &&
          request.resource.data.names is map && request.resource.data.names.size() <= 4;
        allow update: if invited() && (
          // Joining or leaving: only "joined" changes, and only by adding or removing myself.
          (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['joined']) &&
            request.resource.data.joined.toSet().difference(resource.data.joined.toSet()).hasOnly([request.auth.uid]) &&
            resource.data.joined.toSet().difference(request.resource.data.joined.toSet()).hasOnly([request.auth.uid]) &&
            (!(request.auth.uid in request.resource.data.joined) || resource.data.state == 'open')) ||
          // Ending: the host at any time; anyone else only when nobody else is still in the call.
          (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['state', 'endedAt']) &&
            request.resource.data.state == 'ended' &&
            (request.auth.uid == resource.data.hostUid || resource.data.joined.toSet().difference([request.auth.uid].toSet()).size() == 0))
        );
        allow delete: if false;

        match /signal/{sigId} {
          function gc() { return get(/databases/$(database)/documents/families/$(familyId)/groupcalls/$(callId)).data; }
          allow read: if isFamilyMember(familyId) && (request.auth.uid == resource.data.from || request.auth.uid == resource.data.to);
          allow create, update: if isFamilyMember(familyId) &&
            request.resource.data.keys().hasOnly(['from', 'to', 'type', 'sdp', 'nonce', 'at']) &&
            request.resource.data.from == request.auth.uid &&
            request.resource.data.from in gc().memberUids && request.resource.data.to in gc().memberUids &&
            request.resource.data.to != request.auth.uid &&
            request.resource.data.type in ['offer', 'answer'] &&
            sigId == request.resource.data.from + '__' + request.resource.data.to + '__' + request.resource.data.type &&
            request.resource.data.sdp is string && request.resource.data.sdp.size() <= 20000;
          allow delete: if isFamilyMember(familyId) && (request.auth.uid == resource.data.from || request.auth.uid == resource.data.to);
        }
      }

      // One-to-one calls (Beta). A call can be read only by its two people, admins included. The connection
      // details (offer and answer) are separate small documents, so the call list stays light. State changes
      // follow one path: ringing -> accepted / declined / busy / cancelled / missed, accepted -> ended.
      match /calls/{callId} {
        function callAfter() {
          return getAfter(/databases/$(database)/documents/families/$(familyId)/calls/$(callId));
        }
        function callActive(uid) {
          return get(/databases/$(database)/documents/families/$(familyId)/members/$(uid)).data.status == 'ACTIVE';
        }
        function isCaller() { return request.auth.uid == resource.data.callerUid; }
        function isCallee() { return request.auth.uid == resource.data.calleeUid; }

        allow get, list: if isFamilyMember(familyId) && request.auth.uid in resource.data.memberUids;
        allow create: if isFamilyMember(familyId) &&
          request.resource.data.keys().hasOnly(['callerUid', 'calleeUid', 'callerName', 'calleeName', 'memberUids', 'type', 'state', 'clientAt']) &&
          request.resource.data.callerUid == request.auth.uid &&
          request.resource.data.calleeUid is string &&
          request.resource.data.calleeUid != request.auth.uid &&
          request.resource.data.memberUids is list &&
          request.resource.data.memberUids.size() == 2 &&
          request.resource.data.memberUids[0] == request.resource.data.callerUid &&
          request.resource.data.memberUids[1] == request.resource.data.calleeUid &&
          request.resource.data.type in ['video', 'audio'] &&
          request.resource.data.state == 'ringing' &&
          request.resource.data.clientAt is int &&
          request.resource.data.callerName is string && request.resource.data.callerName.size() <= 80 &&
          request.resource.data.calleeName is string && request.resource.data.calleeName.size() <= 80 &&
          callActive(request.resource.data.calleeUid) &&
          existsAfter(/databases/$(database)/documents/families/$(familyId)/calls/$(callId)/signal/offer);
        allow update: if isFamilyMember(familyId) && (isCaller() || isCallee()) &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['state', 'answeredAt', 'endedAt', 'endReason']) &&
          (request.resource.data.get('endReason', '') is string) &&
          ((resource.data.state == 'ringing' && (
              (isCaller() && request.resource.data.state in ['cancelled', 'missed']) ||
              (isCallee() && request.resource.data.state in ['accepted', 'declined', 'busy', 'missed']))) ||
           (resource.data.state == 'accepted' && request.resource.data.state == 'ended'));
        allow delete: if false;

        match /signal/{kind} {
          function theCall() {
            return get(/databases/$(database)/documents/families/$(familyId)/calls/$(callId));
          }
          allow read: if isFamilyMember(familyId) && request.auth.uid in theCall().data.memberUids;
          allow create: if isFamilyMember(familyId) && (kind == 'offer' || kind == 'answer') &&
            request.resource.data.keys().hasOnly(['from', 'type', 'sdp']) &&
            request.resource.data.from == request.auth.uid &&
            request.resource.data.type == kind &&
            request.resource.data.sdp is string &&
            request.resource.data.sdp.size() > 0 && request.resource.data.sdp.size() <= 60000 &&
            ((kind == 'offer' && callAfter().data.callerUid == request.auth.uid && callAfter().data.state == 'ringing') ||
             (kind == 'answer' && callAfter().data.calleeUid == request.auth.uid && callAfter().data.state == 'accepted'));
          allow update: if false;
          // Cleaning up once the call is over.
          allow delete: if isFamilyMember(familyId) && request.auth.uid in theCall().data.memberUids &&
            theCall().data.state in ['cancelled', 'declined', 'busy', 'missed', 'ended'];
        }
      }

      // Live location (Family safety). One document per person, written only by that person while they share.
      // It can be read only by them and by the family members they chose, and only until it expires. Admins and
      // the Super Admin get no extra access. It cannot be listed, so nobody can find who is sharing.
      match /locations/{ownerUid} {
        allow get: if isFamilyMember(familyId) && (
          resource == null ||
          request.auth.uid == ownerUid ||
          (request.auth.uid in resource.data.viewerUids && resource.data.expiresAt > request.time));
        allow list: if false;
        allow create, update: if isFamilyMember(familyId) && request.auth.uid == ownerUid &&
          request.resource.data.keys().hasOnly(['uid', 'name', 'lat', 'lng', 'accuracy', 'battery', 'updatedAt',
            'fixAt', 'expiresAt', 'endAt', 'viewerUids']) &&
          request.resource.data.uid == ownerUid &&
          request.resource.data.name is string && request.resource.data.name.size() <= 80 &&
          request.resource.data.lat is number && request.resource.data.lat >= -90 && request.resource.data.lat <= 90 &&
          request.resource.data.lng is number && request.resource.data.lng >= -180 && request.resource.data.lng <= 180 &&
          request.resource.data.accuracy is number &&
          request.resource.data.battery is int &&
          request.resource.data.updatedAt == request.time &&
          request.resource.data.fixAt is timestamp && request.resource.data.fixAt <= request.time + duration.value(10, 'm') &&
          request.resource.data.expiresAt is timestamp &&
          request.resource.data.expiresAt > request.time &&
          request.resource.data.expiresAt <= request.time + duration.value(9, 'h') &&
          request.resource.data.endAt is int &&
          request.resource.data.viewerUids is list &&
          request.resource.data.viewerUids.size() >= 1 && request.resource.data.viewerUids.size() <= 20 &&
          !(ownerUid in request.resource.data.viewerUids);
        // Stopping sharing deletes it. Only the person sharing can.
        allow delete: if signedIn() && request.auth.uid == ownerUid;
      }

      match /documents/{docId} {
        // Private documents stay visible only to their owner, the people they chose, and the Super Admin.
        allow read: if isFamilyMember(familyId) && (
          isFamilyOwner(familyId) ||
          resource.data.isPrivate == false ||
          resource.data.ownerUid == request.auth.uid ||
          (resource.data.authorizedUids != null && request.auth.uid in resource.data.authorizedUids)
        );
        allow create: if isFamilyMember(familyId) && request.resource.data.ownerUid == request.auth.uid;
        allow update, delete: if isFamilyMember(familyId) && (
          isFamilyOwner(familyId) || resource.data.ownerUid == request.auth.uid
        );
      }
    }
  }
}
